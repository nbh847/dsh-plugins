+// @vitest-environment jsdom
+import { cleanup, fireEvent, render, screen, waitFor } from '@testing-library/react'
+import { afterEach, describe, expect, it, vi } from 'vitest'
+import type { BundleInfo } from '@deepseek-ai/dsh-api-remotes/client'
+import { InstalledPluginsSettingsTab } from '../src/client/InstalledPluginsSettingsTab.tsx'
+import type { InstalledPluginsSettingsTabProps } from '../src/client/InstalledPluginsSettingsTab.tsx'
+import { zh } from '../src/client/locales.ts'
+
+afterEach(cleanup)
+const bundle: BundleInfo = {
+  name: 'dsh-plugin-video-toolkit', version: '0.1.0', installed: true, enabled: true,
+  optional: false, removable: true, rows: [], overrides: [],
+}
+function setup(rows = [bundle]) {
+  const listBundles = vi.fn(async () => rows)
+  const setBundleEnabled = vi.fn(async (name: string, enabled: boolean) => {
+    rows = rows.map(row => row.name === name ? { ...row, enabled } : row)
+    return { changed: true, application: 'applied' as const, stage: 'enable' as const, target: name, enabled }
+  })
+  const props = {
+    listBundles, setBundleEnabled, subscribe: () => () => {},
+    t: (key: keyof typeof zh) => zh[key],
+  } as InstalledPluginsSettingsTabProps
+  render(<InstalledPluginsSettingsTab {...props} />)
+  return { listBundles, setBundleEnabled }
+}
+
+describe('installed bundle Settings controls', () => {
+  it('disables a bundle and keeps the control available to re-enable it', async () => {
+    const b = setup()
+    const control = await screen.findByRole('switch')
+    expect(control.getAttribute('aria-checked')).toBe('true')
+    fireEvent.click(control)
+    await waitFor(() => { expect(control.getAttribute('aria-checked')).toBe('false') })
+    fireEvent.click(control)
+    await waitFor(() => { expect(control.getAttribute('aria-checked')).toBe('true') })
+    expect(b.setBundleEnabled.mock.calls).toEqual([[bundle.name, false], [bundle.name, true]])
+  })
+  it('allows disabling an enabled faulty bundle but prevents re-enabling it', async () => {
+    const b = setup([{ ...bundle, error: 'Invalid bundle manifest' }])
+    const control = await screen.findByRole('switch')
+    expect(control.hasAttribute('disabled')).toBe(false)
+    fireEvent.click(control)
+    await waitFor(() => { expect(control.getAttribute('aria-checked')).toBe('false') })
+    expect(control.hasAttribute('disabled')).toBe(true)
+    fireEvent.click(control)
+    expect(b.setBundleEnabled.mock.calls).toEqual([[bundle.name, false]])
+  })
+  it('prevents enabling an already disabled faulty bundle', async () => {
+    const b = setup([{ ...bundle, enabled: false, error: 'Missing bundle patch' }])
+    const control = await screen.findByRole('switch')
+    expect(control.hasAttribute('disabled')).toBe(true)
+    fireEvent.click(control)
+    expect(b.setBundleEnabled).not.toHaveBeenCalled()
+  })
+  it('does not offer mutable controls for profile-read-only bundles', async () => {
+    setup([{ ...bundle, readOnlyReason: 'management-required' }])
+    expect((await screen.findByRole('switch')).hasAttribute('disabled')).toBe(true)
+  })
+  it('shows disabled installed bundles and excludes installation-provided bundles', async () => {
+    setup([{ ...bundle, enabled: false }, { ...bundle, name: 'shipped', installed: false }])
+    expect((await screen.findByRole('switch')).getAttribute('aria-checked')).toBe('false')
+    expect(screen.queryByText('shipped')).toBeNull()
+  })
+  it.each(['failed', 'cancelled'] as const)('retains the %s operation error after refreshing authoritative rows', async (application) => {
+    const b = setup()
+    b.setBundleEnabled.mockResolvedValueOnce({ changed: false, application, stage: 'enable', target: bundle.name, enabled: false } as never)
+    const control = await screen.findByRole('switch')
+    fireEvent.click(control)
+    await waitFor(() => { expect(b.listBundles).toHaveBeenCalledTimes(2) })
+    expect(screen.getByRole('alert')).not.toBeNull()
+    expect(control.getAttribute('aria-checked')).toBe('true')
+  })
+  it('does not reflect a failed activation as success', async () => {
+    const b = setup()
+    b.setBundleEnabled.mockRejectedValueOnce(new Error('refused'))
+    const control = await screen.findByRole('switch')
+    fireEvent.click(control)
+    await screen.findByRole('alert')
+    expect(control.getAttribute('aria-checked')).toBe('true')
+  })
+})
