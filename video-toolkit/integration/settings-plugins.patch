--- /dev/null
+++ b/packages/client/ui-settings-plugin-inventory/src/client/InstalledPluginsSettingsTab.tsx
@@ -0,0 +1,70 @@
+/** Installed bundle controls remain available when a managed bundle is disabled. */
+import { useEffect, useState, type ReactNode } from 'react'
+import type { BundleInfo, ChangeResult } from '@deepseek-ai/dsh-api-remotes/client'
+import type { InjectFace, PropsLocale, PropsRuntime } from '@deepseek-ai/dsh-client-ui-slots'
+
+/** Settings projection of the profile manager's persistent bundle operations. */
+export interface InstalledPluginsSettingsTabInjected {
+  /** Read installed bundles, including disabled bundles. */
+  listBundles: () => Promise<BundleInfo[]>
+  /** Persist one bundle's activation and report its observed application outcome. */
+  setBundleEnabled: (name: string, enabled: boolean) => Promise<ChangeResult>
+  /** Subscribe to profile changes and reconnects; return the subscription disposer. */
+  subscribe: (listener: () => void) => () => void
+}
+
+/** Props supplied by the Settings slot renderer. */
+export type InstalledPluginsSettingsTabProps = PropsRuntime<'settings.plugins.tab'>
+  & PropsLocale<'settings.pluginInventory'> & InjectFace<InstalledPluginsSettingsTabInjected>
+
+/** Render persistent profile controls without mounting any managed plugin's client code. */
+export function InstalledPluginsSettingsTab({ listBundles, setBundleEnabled, subscribe, t }: InstalledPluginsSettingsTabProps): ReactNode {
+  const [rows, setRows] = useState<BundleInfo[]>()
+  const [revision, setRevision] = useState(0)
+  const [error, setError] = useState(false)
+  const [readError, setReadError] = useState(false)
+  const [busy, setBusy] = useState<string>()
+  const [notice, setNotice] = useState<'restartRequired' | 'activationOverridden'>()
+  useEffect(() => subscribe(() => { setRevision(value => value + 1) }), [subscribe])
+  useEffect(() => {
+    let current = true
+    void listBundles().then(
+      (value) => { if (current) { setRows(value.filter(row => row.installed)); setReadError(false) } },
+      () => { if (current) setReadError(true) },
+    )
+    return () => { current = false }
+  }, [listBundles, revision])
+
+  const toggle = async (row: BundleInfo): Promise<void> => {
+    setBusy(row.name)
+    setError(false)
+    setNotice(undefined)
+    try {
+      const result = await setBundleEnabled(row.name, !row.enabled)
+      if (result.application === 'failed' || result.application === 'cancelled') setError(true)
+      else if (result.application === 'restart-required') setNotice('restartRequired')
+      else if (result.application === 'overridden') setNotice('activationOverridden')
+      setRevision(value => value + 1)
+    } catch (_managementFailure) {
+      setError(true)
+    } finally {
+      setBusy(undefined)
+    }
+  }
+
+  return <section aria-label={t('installedTab')}>
+    <p>{t('installedIntro')}</p>
+    {error || readError ? <p role="alert">{t('managementError')} <button type="button" onClick={() => { setError(false); setReadError(false); setRevision(value => value + 1) }}>{t('retry')}</button></p> : null}
+    {notice === undefined ? null : <p role="status">{t(notice)}</p>}
+    {rows === undefined ? <p>{t('loading')}</p> : rows.length === 0 ? <p>{t('empty')}</p> : <ul>
+      {rows.map(row => <li key={row.name}>
+        <code>{row.name}</code>{row.version === undefined ? null : <> {row.version}</>}
+        {' '}<span>{t(row.enabled ? 'enabledTag' : 'disabledTag')}</span>{' '}
+        <button type="button" role="switch" aria-checked={row.enabled} aria-label={`${row.name} ${t('activation')}`}
+          disabled={busy !== undefined || row.readOnlyReason !== undefined || (!row.enabled && row.error !== undefined)}
+          onClick={() => { void toggle(row) }}>{t(row.enabled ? 'disable' : 'enable')}</button>
+        {row.readOnlyReason === undefined ? null : <span> {t('readOnly')}</span>}
+      </li>)}
+    </ul>}
+  </section>
+}
