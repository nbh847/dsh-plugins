# The dsh host reads these from ~/.dsh/.env or the launch-directory .env,
# not from this file. This template only documents the variables.
SENSENOVA_API_KEY=
# Optional; official model for the synchronous image endpoint.
SENSENOVA_IMAGE_MODEL=sensenova-u1.5-lite
# Optional; official synchronous image API origin.
SENSENOVA_BASE_URL=
